# Porta da API (o Vite roda em 5173 e faz proxy de /api para cá)
API_PORT=3000

# Segredo usado para assinar o cookie de sessão (JWT). Gere algo aleatório,
# ex.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=troque-por-um-segredo-aleatorio

# Chave da API do Gemini (Google AI Studio), usada para gerar os flashcards
# a partir do PDF.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: chave da API da OpenAI. Quando configurada, tópico/texto/arquivo
# (PDF com texto extraível ou imagem) passam a ser gerados por ela em vez do
# Gemini, com fallback automático pro Gemini se a OpenAI falhar. YouTube e
# áudio/vídeo continuam sempre no Gemini (a OpenAI não tem equivalente nativo).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional: chave da API da Anthropic (Claude). É cobrada à parte da assinatura
# do Claude: precisa de créditos em console.anthropic.com. Quando configurada,
# entra como reserva — se OpenAI e Gemini falharem, o Claude tenta. Cobre tópico,
# texto, imagem, PDF (inclusive escaneado), resumos, mapas mentais, bullet points
# e a análise de edital. Áudio, vídeo e YouTube continuam só no Gemini.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: troca o modelo do Claude (o padrão é claude-sonnet-5-5).
# ANTHROPIC_MODEL=

# Leitura em voz alta: a voz "natural" é gerada pelo Gemini (modelo de voz), usa a
# mesma GEMINI_API_KEY e fica guardada em disco depois de gerada — ouvir de novo o
# mesmo cartão não gasta nada. No plano gratuito o Gemini tem um limite diário de
# requisições por modelo; quando acaba, o app lê com a voz do navegador.
# Modelo de voz (o padrão é gemini-3.8-flash-tts; existe uma versão "lite" mais barata):
# GEMINI_TTS_MODEL=
# Onde guardar os áudios. O padrão fica fora da pasta do projeto, em
# %LOCALAPPDATA%\BaseConcurseira\tts-cache, para não sincronizar com o OneDrive.
# TTS_CACHE_DIR=
# Tamanho máximo dessa pasta, em MB (o padrão é 1024). Passando disso, apaga o menos usado.
# TTS_CACHE_MAX_MB=

# Opcional: ordem em que os provedores de IA são tentados, separados por vírgula.
# O padrão é openai,gemini,claude. Um provedor que não está na lista nunca é
# usado, mesmo com chave — dá pra desligar um sem apagar a chave. Ex.: claude,gemini
# AI_PROVIDER_ORDER=
